# ---------------------------------------------------------------------------
# JSS MIS — environment
# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
# Never put real values in this file.
# ---------------------------------------------------------------------------

# Neon, POOLED connection (has "-pooler" in the host).
# Used by the running app. Handles many short-lived serverless connections.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Neon, DIRECT connection (no "-pooler" in the host).
# Used by drizzle-kit for migrations only. Migrations need a stable session,
# which a pooled connection cannot guarantee.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# Auth.js session signing secret. Generate with:
#   openssl rand -base64 32
# (Not `npx auth secret` — that installs Better Auth's CLI, a different library.)
AUTH_SECRET="replace-me"

# Guards the nightly PO-status recompute endpoint
# (/api/cron/recompute-po-status), which Vercel calls with this as a bearer
# token. Optional locally — there is no cron in development, and the route
# refuses every request when this is unset rather than running unauthenticated.
# Generate with: openssl rand -base64 32
CRON_SECRET=
